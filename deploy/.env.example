# ============ إعدادات الاستضافة المحلية ============
# انسخ هذا الملف إلى deploy/.env وعدّل القيم قبل التشغيل

# عنوان السيرفر المحلي (IP أو دومين داخلي) — يُستخدم في المتصفح
PUBLIC_HOST=http://192.168.1.10

# ---- قاعدة البيانات ----
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ---- مفاتيح JWT للمصادقة و الـ API ----
# ولّدها بالأمر: openssl rand -base64 48   (طوله 40 حرفاً فأكثر)
JWT_SECRET=change-me-at-least-40-characters-long-secret-value
# ولّد المفتاحين من https://supabase.com/docs/guides/self-hosting#api-keys
# (JWT موقّع بـ JWT_SECRET، role=anon و role=service_role)
ANON_KEY=paste-anon-jwt-here
SERVICE_ROLE_KEY=paste-service-role-jwt-here

# ---- البريد الإلكتروني (اختياري: إشعارات ورسائل النظام) ----
SMTP_HOST=smtp.yateemdev.org
SMTP_PORT=587
SMTP_USER=no-reply@yateemdev.org
SMTP_PASS=change-me
SMTP_SENDER_NAME=نظام الموارد البشرية

# ---- المنافذ ----
APP_PORT=3000
GATEWAY_PORT=8000
